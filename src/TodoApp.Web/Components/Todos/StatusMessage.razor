@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="status-message @(IsError ? "error" : "success")" role="@(IsError ? "alert" : "status")" aria-live="polite">
        <span class="status-label">@(IsError ? "Error" : "Status"):</span> @Message
        @if (ShowReload)
        {
            <button type="button" @onclick="OnReload">Reload latest values</button>
        }
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public bool ShowReload { get; set; }
    [Parameter] public EventCallback OnReload { get; set; }
}
